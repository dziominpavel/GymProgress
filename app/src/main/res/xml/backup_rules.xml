<?xml version="1.0" encoding="utf-8"?>
<!--
    Правила Auto Backup для Android 11 и ниже.
    Включаем БД Room (gym_progress_db, gym_progress_db-shm, gym_progress_db-wal)
    и DataStore Preferences (files/datastore/settings.preferences_pb).
    Кэши и no_backup исключаются Android-ом по умолчанию.

    Для Android 12+ используется res/xml/data_extraction_rules.xml.
-->
<full-backup-content>
    <include domain="database" path="gym_progress_db" />
    <include domain="database" path="gym_progress_db-shm" />
    <include domain="database" path="gym_progress_db-wal" />
    <include domain="file" path="datastore/" />
</full-backup-content>
