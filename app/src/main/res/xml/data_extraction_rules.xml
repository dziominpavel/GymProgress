<?xml version="1.0" encoding="utf-8"?>
<!--
    Правила извлечения данных для Android 12+.
    cloud-backup — бэкап в Google One; device-transfer — прямая передача между устройствами.
    Включаем БД Room и DataStore Preferences; кэши и no_backup исключаются по умолчанию.

    Для Android 11 и ниже используется res/xml/backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="gym_progress_db" />
        <include domain="database" path="gym_progress_db-shm" />
        <include domain="database" path="gym_progress_db-wal" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="gym_progress_db" />
        <include domain="database" path="gym_progress_db-shm" />
        <include domain="database" path="gym_progress_db-wal" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
